fbi       2.14.3   aarch64  5116d5ee382f2343d4fec48b534cf935
fbi       2.14.4   armhf    a96c1db29ceea30dc080324fc99ad685
fbterm    1.7.5    aarch64  cd9e29cb1ef7ef31c1a240d2e01fac47
fbterm    1.7.5    armhf    bc77909893b77d97ebd74a1839c6a6fb
